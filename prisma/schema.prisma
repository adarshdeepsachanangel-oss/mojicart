datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & RBAC
// -------------------------------------------------------------
model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  role              String    @default("CUSTOMER") // CUSTOMER, SELLER, SUPER_ADMIN, OPERATIONS_ADMIN, CATALOG_MANAGER, ORDER_MANAGER, SUPPORT_STAFF, FINANCE_MANAGER
  status            String    @default("ACTIVE")   // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  avatar            String?
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses         Address[]
  sellerProfile     Seller?
  orders            Order[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  supportTickets    SupportTicket[]
  statusHistory     OrderStatusHistory[]
  supportMessages   SupportMessage[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  phone        String
  pincode      String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  addressType  String   @default("HOME") // HOME, WORK, OTHER
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// SELLER / VENDOR
// -------------------------------------------------------------
model Seller {
  id                String    @id @default(uuid())
  userId            String    @unique
  storeName         String
  storeSlug         String    @unique
  description       String?
  logoUrl           String?
  bannerUrl         String?
  gstin             String?
  pan               String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  commissionRate    Float     @default(10.0) // Marketplace commission %
  status            String    @default("PENDING") // PENDING, APPROVED, SUSPENDED, REJECTED
  rejectionReason   String?
  rating            Float     @default(0.0)
  totalSales        Float     @default(0.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          Product[]
  orderItems        OrderItem[]
  settlements       SellerSettlement[]
  coupons           Coupon[]
}

// -------------------------------------------------------------
// CATALOG: CATEGORIES, BRANDS, PRODUCTS, VARIANTS
// -------------------------------------------------------------
model Category {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  description    String?
  icon           String?
  imageUrl       String?
  parentId       String?
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)
  level          Int        @default(1)
  commissionRate Float      @default(10.0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parent         Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children       Category[] @relation("SubCategories")
  products       Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Product {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  description      String
  categoryId       String
  brandId          String?
  sellerId         String
  status           String           @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, ARCHIVED
  rejectionReason  String?
  basePrice        Float            // Selling price
  mrp              Float            // Maximum Retail Price
  discountPercent  Float            @default(0.0)
  taxRate          Float            @default(18.0) // GST %
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isUnder199       Boolean          @default(false)
  isUnder499       Boolean          @default(false)
  rating           Float            @default(0.0)
  reviewCount      Int              @default(0)
  totalSold        Int              @default(0)
  returnPolicyDays Int              @default(7)
  sku              String           @unique
  stock            Int              @default(0)
  highlights       String?          // JSON or newline separated text
  specs            String?          // JSON string { "Fabric": "Cotton", "Pattern": "Solid" }
  importSource     String?          // e.g. "MEESHO"
  sourceUrl        String?          // Original source URL
  sourceProductId  String?          // Original product ID from source
  sourcePrice      Float?           // Original source price
  sourceMrp        Float?           // Original source MRP
  sourceRating     Float?           // Original source rating
  sourceReviewCount Int?            // Original source review count
  sourceData       String?          // JSON snapshot of raw/normalized source response
  importJobId      String?          // Related import job ID
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id])
  brand            Brand?           @relation(fields: [brandId], references: [id])
  seller           Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  stockMovements   StockMovement[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String   @unique
  title      String   // e.g. "Size: M, Color: Blue"
  price      Float
  mrp        Float
  stock      Int      @default(0)
  attributes String?  // JSON string e.g. {"Size":"M","Color":"Blue"}
  imageUrl   String?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]
}

// -------------------------------------------------------------
// INVENTORY & WAREHOUSE
// -------------------------------------------------------------
model Warehouse {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  city        String
  state       String
  pincode     String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  movements   StockMovement[]
}

model StockMovement {
  id            String     @id @default(uuid())
  warehouseId   String?
  productId     String
  variantId     String?
  changeQty     Int
  reason        String     // PURCHASE, SALE, RETURN, DAMAGE, ADJUSTMENT
  referenceType String?    // ORDER, AUDIT, MANUAL
  referenceId   String?
  createdAt     DateTime   @default(now())

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
}

// -------------------------------------------------------------
// CART & WISHLIST
// -------------------------------------------------------------
model CartItem {
  id         String          @id @default(uuid())
  userId     String?
  sessionId  String?         // For guest carts
  productId  String
  variantId  String?
  quantity   Int             @default(1)
  priceAtAdd Float
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// -------------------------------------------------------------
// ORDERS & FULFILLMENT
// -------------------------------------------------------------
model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  customerId            String
  totalAmount           Float
  subtotal              Float
  discountAmount        Float                @default(0.0)
  couponCode            String?
  couponDiscount        Float                @default(0.0)
  shippingFee           Float                @default(0.0)
  taxAmount             Float                @default(0.0)
  paymentMethod         String               @default("RAZORPAY") // RAZORPAY, COD, UPI
  paymentStatus         String               @default("PENDING")  // PENDING, PAID, FAILED, REFUNDED
  orderStatus           String               @default("CONFIRMED")// PENDING, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED
  deliveryAddress       String               // JSON snapshot of shipping address
  shippingCarrier       String?
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  customer              User                 @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  refunds               Refund[]
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  sellerId         String
  productId        String
  variantId        String?
  title            String
  price            Float
  mrp              Float
  quantity         Int
  total            Float
  commissionAmount Float           @default(0.0)
  sellerPayout     Float           @default(0.0)
  status           String          @default("CONFIRMED") // CONFIRMED, PACKED, SHIPPED, DELIVERED, CANCELLED, RETURNED
  createdAt        DateTime        @default(now())

  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller           Seller          @relation(fields: [sellerId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id              String   @id @default(uuid())
  orderId         String
  fromStatus      String
  toStatus        String
  changedByUserId String?
  comment         String?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [changedByUserId], references: [id])
}

// -------------------------------------------------------------
// PAYMENTS & REFUNDS
// -------------------------------------------------------------
model Payment {
  id             String   @id @default(uuid())
  orderId        String
  transactionId  String   @unique
  provider       String   @default("RAZORPAY") // RAZORPAY, COD, UPI
  amount         Float
  currency       String   @default("INR")
  status         String   @default("PAID")    // PENDING, PAID, FAILED, REFUNDED
  rawResponse    String?  // JSON response from gateway
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Refund {
  id          String   @id @default(uuid())
  orderId     String
  orderItemId String?
  amount      Float
  reason      String
  status      String   @default("REQUESTED") // REQUESTED, APPROVED, PROCESSED, REJECTED
  refundTxnId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// MARKETING & PROMOTIONS
// -------------------------------------------------------------
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue Float
  minOrderValue Float     @default(0.0)
  maxDiscount   Float?
  usageLimit    Int       @default(1000)
  usageCount    Int       @default(0)
  perUserLimit  Int       @default(1)
  startDate     DateTime  @default(now())
  endDate       DateTime
  isActive      Boolean   @default(true)
  sellerId      String?
  createdAt     DateTime  @default(now())

  seller        Seller?   @relation(fields: [sellerId], references: [id])
}

// -------------------------------------------------------------
// REVIEWS & MODERATION
// -------------------------------------------------------------
model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int      @default(5)
  title              String?
  comment            String
  images             String?  // JSON string array of URLs
  isVerifiedPurchase Boolean  @default(false)
  status             String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  helpfulVotes       Int      @default(0)
  createdAt          DateTime @default(now())

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// SUPPORT & DISPUTES
// -------------------------------------------------------------
model SupportTicket {
  id             String           @id @default(uuid())
  ticketNumber   String           @unique
  customerId     String
  orderId        String?
  subject        String
  priority       String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String           @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedStaffId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer       User             @relation(fields: [customerId], references: [id])
  messages       SupportMessage[]
}

model SupportMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderId    String
  senderRole  String        // CUSTOMER, STAFF
  message     String
  attachments String?       // JSON array
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id])
}

// -------------------------------------------------------------
// SELLER SETTLEMENTS & FINANCE
// -------------------------------------------------------------
model SellerSettlement {
  id               String   @id @default(uuid())
  sellerId         String
  settlementNumber String   @unique
  periodStart      DateTime
  periodEnd        DateTime
  grossSales       Float
  totalCommission  Float
  totalTaxTds      Float    @default(0.0)
  netPayout        Float
  status           String   @default("PENDING") // PENDING, PROCESSING, PAID
  payoutDate       DateTime?
  bankReference    String?
  createdAt        DateTime @default(now())

  seller           Seller   @relation(fields: [sellerId], references: [id])
}

// -------------------------------------------------------------
// HOMEPAGE CMS & CONFIGURATION
// -------------------------------------------------------------
model HomepageSection {
  id           String   @id @default(uuid())
  sectionKey   String   @unique
  title        String
  subtitle     String?
  sectionType  String   // HERO_SLIDER, CATEGORY_TILES, DEALS_GRID, BUDGET_ZONE, BEST_SELLERS, PROMO_BANNER
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  config       String?  // JSON string containing IDs, timers, or custom parameters
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CMSBanner {
  id             String    @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String    @default("/")
  tagText        String?
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  startDate      DateTime  @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())
}

model GlobalSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// PRODUCT IMPORTS & SCRAPING ENGINE (MEESHO & MULTI-SOURCE)
// -------------------------------------------------------------
model ImportJob {
  id              String       @id @default(uuid())
  source          String       @default("MEESHO") // MEESHO
  status          String       @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, PARTIAL, CANCELLED
  totalUrls       Int          @default(0)
  processedCount  Int          @default(0)
  successCount    Int          @default(0)
  failedCount     Int          @default(0)
  skippedCount    Int          @default(0)
  apifyRunId      String?
  apifyDatasetId  String?
  errorMessage    String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           ImportItem[]
}

model ImportItem {
  id                String       @id @default(uuid())
  jobId             String
  sourceUrl         String
  sourceProductId   String?
  title             String?
  status            String       @default("QUEUED") // QUEUED, FETCHING, EXTRACTED, AWAITING_REVIEW, DOWNLOADING_IMAGES, SAVING_PRODUCT, IMPORTED_DRAFT, PUBLISHED, DUPLICATE_SKIPPED, FAILED, CANCELLED
  errorDetails      String?
  extractedData     String?      // JSON of normalized extracted product data
  sourcePrice       Float?
  sourceMrp         Float?
  imagesFound       Int          @default(0)
  imagesDownloaded  Int          @default(0)
  isDuplicate       Boolean      @default(false)
  existingProductId String?
  productId         String?      // Resulting Mojicart product ID if imported
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  job               ImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
