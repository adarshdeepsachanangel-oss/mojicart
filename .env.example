# Mojicart Environment Variables Example

# Database
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mojicart?schema=public"

# Authentication & Security
JWT_SECRET="replace_with_strong_random_secret_in_production"
NEXTAUTH_SECRET="replace_with_strong_random_secret_in_production"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mojicart"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Logistics (Optional)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
DELHIVERY_API_KEY=""

# Email SMTP
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Mojicart <no-reply@mojicart.in>"

# Meesho Product Scraper (Apify Actor: ecomscrape/meesho-product-details-page-scraper)
# Get your API token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN="apify_api_your_token_here"
# Optional: Set to "true" for offline testing mode when API token is not yet provisioned
APIFY_MOCK_FALLBACK="true"
